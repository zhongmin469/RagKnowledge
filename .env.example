# ============================================================================
# RagKnowledge 环境变量样例：复制为项目根 .env 后填入真实值；.env 不入库（见 .gitignore）
# 后端在 backend/ 目录启动时读取项目根 ../.env 与 backend/.env，环境变量优先级最高。
# 真实 Key 一律留空或使用占位符；不要在本文件写入任何生产凭据。
# ============================================================================

# ---------- 服务 ----------
# 服务监听地址；仅本机使用保持 127.0.0.1
APP_HOST=127.0.0.1
# 后端监听端口
APP_PORT=8000
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 允许跨域的前端地址，多个用英文逗号分隔
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---------- 数据库 ----------
# PostgreSQL 连接串：postgresql://用户:密码@主机:端口/库名
DB_DSN=postgresql://postgres:postgres@127.0.0.1:5432/rag_agent
# 连接池最小连接数
DB_POOL_MIN=2
# 连接池最大连接数
DB_POOL_MAX=10

# ---------- 主模型 ----------
# 历史兼容变量，仅作记录；代码实际读取 LLM_API_KEY，建议保持同值
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 主模型供应商标识；当前走 OpenAI 兼容协议
LLM_PROVIDER=deepseek
# 主模型 OpenAI 兼容端点
LLM_BASE_URL=https://api.deepseek.com
# 主模型 API Key；缺失时生成能力不可用
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 主模型名称
LLM_MODEL=deepseek-chat
# 是否启用主/小模型分级路由
LLM_ROUTING_ENABLED=true
# 主模型调用超时（秒）
LLM_TIMEOUT=60

# ---------- 小模型 ----------
# 轻任务小模型；置空则回落主模型
LLM_SMALL_MODEL=qwen3.6-flash
# 小模型 OpenAI 兼容端点；置空则回落主模型
LLM_SMALL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 小模型 API Key；可复用百炼 Key，但变量名独立
LLM_SMALL_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 允许走小模型的用途，英文逗号分隔
LLM_SMALL_PURPOSES=summary,memory_extract,title,query_rewrite

# ---------- Embedding ----------
# 向量化提供方：local / api / ollama
EMBEDDING_PROVIDER=api
# Embedding 模型名称
EMBEDDING_MODEL=text-embedding-v3
# 向量维度，必须与表列 vector(N) 一致
EMBEDDING_DIM=1024
# 单批向量化条数；百炼兼容模式单次最多 10
EMBEDDING_BATCH_SIZE=10
# Embedding OpenAI 兼容端点
EMBEDDING_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Embedding 与 Rerank 共用的百炼 Key；缺失时入库/检索向量化失败
EMBEDDING_API_KEY=

# ---------- 切片与检索 ----------
# 单个切片字符数
CHUNK_SIZE=500
# 相邻切片重叠字符数；必须小于 CHUNK_SIZE
CHUNK_OVERLAP=100
# 最终交给生成与来源卡片的片段数
TOP_K=5
# 余弦相似度阈值；0 表示不过滤，注意不是 rerank 分数
RETRIEVAL_MIN_SCORE=0.5
# 是否启用二次精排；当前环境可设为 true
RERANK_ENABLED=false
# 重排模型名称
RERANK_MODEL=gte-rerank-v2
# 重排后保留条数；<=0 表示保留全部候选
RERANK_TOP_N=5
# HNSW 查询候选宽度；调大提高召回、增加延迟
HNSW_EF_SEARCH=40
# pgvector 0.8+ 迭代扫描：off / relaxed_order / strict_order
HNSW_ITERATIVE_SCAN=relaxed_order
# 迭代扫描最大扫描元组数
HNSW_MAX_SCAN_TUPLES=20000

# ---------- Agent ----------
# 旧字段，仅兼容旧调用方；新逻辑使用 HISTORY_WINDOW_ROUNDS
HISTORY_ROUNDS=5
# 工具循环上限，防止重复回跳死循环
MAX_TOOL_ROUNDS=3

# ---------- 上传 ----------
# 单次请求整体上传硬上限（MB）
UPLOAD_MAX_MB=10
# 原始文档落盘目录，相对项目根
UPLOAD_DIR_NAME=data/uploads
# Excel/CSV 解析上限：单文件最多解析的工作表数
EXCEL_MAX_SHEETS=20
# Excel/CSV 单表最多保留的有效行数；超限截断并写入标记
EXCEL_MAX_ROWS_PER_SHEET=5000
# Excel/CSV 单表最多列数
EXCEL_MAX_COLS=200
# 单个单元格最多保留字符数
EXCEL_MAX_CELL_CHARS=200
# .doc 转 .docx 的超时秒数（LibreOffice 或 Windows Word COM）
DOC_CONVERT_TIMEOUT=60

# ---------- 默认管理员 ----------
# 初始管理员用户名；仅首次建库/找回账号时使用
DEFAULT_ADMIN_USERNAME=admin
# 初始管理员密码；生产环境务必覆盖或置空改为随机生成
DEFAULT_ADMIN_PASSWORD=Admin@12345
# 初始管理员显示名
DEFAULT_ADMIN_DISPLAY_NAME=系统管理员
# 登录页是否显示演示账号提示；生产环境必须为 false
DEMO_CREDENTIAL_HINT=false

# ---------- 联网搜索 ----------
# 知识库命中不足时是否允许联网兜底
WEB_SEARCH_ENABLED=true
# 搜索供应商：bailian / bocha / tavily
WEB_SEARCH_PROVIDER=bailian
# 搜索服务基础地址；留空使用供应商默认地址
WEB_SEARCH_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# 百炼联网问答模型，需要支持 enable_search
WEB_SEARCH_MODEL=qwen-plus
# 百炼搜索策略：turbo / max / agent
WEB_SEARCH_STRATEGY=turbo
# 搜索超时（秒）
WEB_SEARCH_TIMEOUT=20
# 单次搜索返回结果数上限
WEB_SEARCH_MAX_RESULTS=5
# 百炼搜索专用 Key；为空时回落 EMBEDDING_API_KEY
BAILIAN_SEARCH_API_KEY=
# 博查 / Tavily 的 Key；切换供应商时才需要
WEB_SEARCH_API_KEY=
# 是否允许把 LLM Key 当搜索 Key；默认关闭
WEB_SEARCH_REUSE_LLM_KEY=false

# ---------- 管理端审计与查看留痕（v5 R8/R9）----------
# 管理员查看他人问答/链路的去重窗口（秒）
ADMIN_VIEW_LOG_DEDUP_SECONDS=60
# 审计日志保留天数（仅提示，不自动清理）
AUDIT_LOG_RETENTION_DAYS=730
# 用户详情概览统计缓存秒数；0 = 关闭
ADMIN_OVERVIEW_CACHE_SECONDS=0
